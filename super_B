local function clearList()
	for _,v in ipairs(Scroll:GetChildren()) do
		if v:IsA("TextButton") then
			v:Destroy()
		end
	end
end

local function refreshList()
	clearList()

	for i,note in ipairs(NOTES) do
		local item=Instance.new("TextButton")
		item.Size=UDim2.new(1,-8,0,36)
		item.BackgroundColor3=Color3.fromRGB(38,38,48)
		item.BorderSizePixel=0
		item.Text=note.name or ("Script "..i)
		item.TextColor3=Color3.fromRGB(235,235,240)
		item.TextSize=11
		item.Font=Enum.Font.Gotham
		item.TextXAlignment=Enum.TextXAlignment.Left
		item.TextTruncate=Enum.TextTruncate.AtEnd
		item.ClipsDescendants=true
		item.LayoutOrder=i
		item.AutoButtonColor=true
		item.Parent=Scroll

		local pad=Instance.new("UIPadding")
		pad.PaddingLeft=UDim.new(0,9)
		pad.PaddingRight=UDim.new(0,6)
		pad.Parent=item

		local c=Instance.new("UICorner")
		c.CornerRadius=UDim.new(0,6)
		c.Parent=item

		item.MouseButton1Click:Connect(function()
			selectedIndex=i
			CodeBox.Text=NOTES[i].code or ""

			ListPage.Visible=false
			ContentPage.Visible=true
		end)
	end
end

Exit.MouseButton1Click:Connect(function()
	ContentPage.Visible=false
	ListPage.Visible=true
end)

Copy.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard(CodeBox.Text)
	end
end)

local function setSize(w,h)
	w=math.clamp(w,MIN_W,MAX_W)
	h=math.clamp(h,MIN_H,MAX_H)

	Main.Size=UDim2.fromOffset(w,h)

	if not minimized then
		lastW=w
		lastH=h
	end
end

local resizing=false
local resizeStart
local resizeSize

local Resize=Instance.new("TextButton")
Resize.Size=UDim2.fromOffset(20,20)
Resize.Position=UDim2.new(1,-20,1,-20)
Resize.BackgroundTransparency=1
Resize.Text="◢"
Resize.TextColor3=Color3.fromRGB(160,160,175)
Resize.TextSize=13
Resize.Font=Enum.Font.GothamBold
Resize.ZIndex=30
Resize.Parent=Main

Resize.InputBegan:Connect(function(input)
	if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseButton1 then
		return
	end

	resizing=true
	resizeStart=input.Position
	resizeSize=Main.AbsoluteSize

	input.Changed:Connect(function()
		if input.UserInputState==Enum.UserInputState.End then
			resizing=false
		end
	end)
end)

UIS.InputChanged:Connect(function(input)
	if not resizing then
		return
	end

	if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseMovement then
		return
	end

	local delta=input.Position-resizeStart

	setSize(
		resizeSize.X+delta.X,
		resizeSize.Y+delta.Y
	)
end)

local dragging=false
local dragStart
local startPos

DragBar.InputBegan:Connect(function(input)
	if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseButton1 then
		return
	end

	dragging=true
	dragStart=input.Position
	startPos=Main.Position

	input.Changed:Connect(function()
		if input.UserInputState==Enum.UserInputState.End then
			dragging=false
		end
	end)
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType~=Enum.UserInputType.Touch
		and input.UserInputType~=Enum.UserInputType.MouseMovement then
		return
	end

	local delta=input.Position-dragStart

	Main.Position=UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset+delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset+delta.Y
	)
end)

Collapse.MouseButton1Click:Connect(function()
	minimized=not minimized

	if minimized then
		lastW=Main.AbsoluteSize.X
		lastH=Main.AbsoluteSize.Y

		Main.Size=UDim2.fromOffset(lastW,MINI_H)

		ListPage.Visible=false
		ContentPage.Visible=false
		Resize.Visible=false

		Collapse.Text="+"
	else
		Main.Size=UDim2.fromOffset(lastW,lastH)

		if selectedIndex and NOTES[selectedIndex] then
			ListPage.Visible=false
			ContentPage.Visible=true
		else
			ListPage.Visible=true
			ContentPage.Visible=false
		end

		Resize.Visible=true
		Collapse.Text="-"
	end
end)

local lastSignature=""

task.spawn(function()
	while gui.Parent do
		local parts={}

		for i,note in ipairs(NOTES) do
			parts[#parts+1]=tostring(i)
			parts[#parts+1]=tostring(note.name)
			parts[#parts+1]=tostring(#(note.code or ""))
		end

		local signature=table.concat(parts,"|")

		if signature~=lastSignature then
			lastSignature=signature

			if selectedIndex and not NOTES[selectedIndex] then
				selectedIndex=nil
				CodeBox.Text=""
				ContentPage.Visible=false
				ListPage.Visible=true
			end

			refreshList()
		end

		task.wait(.4)
	end
end)

refreshList()
